# ============================================================================
# TechTrendIndia — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ============================================================================

# --- Supabase ---
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# --- Razorpay ---
# Get these from: Razorpay Dashboard → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# --- WhatsApp Business API (Interakt/Wati/AiSensy) ---
# Fill when WhatsApp automation is set up
WHATSAPP_API_URL=https://api.interakt.ai/v1/public/message/
WHATSAPP_API_KEY=your-api-key-here

# --- App ---
NEXT_PUBLIC_SITE_URL=https://tech-trend-india-4dak.vercel.app/
